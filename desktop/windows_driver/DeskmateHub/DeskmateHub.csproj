<Project Sdk="Microsoft.NET.Sdk">

  <!-- Deskmate Hub for Windows: a tray app that sends data to the Deskmate phone app over BLE. -->
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <!-- Windows 10 2004+ SDK projections give access to Windows.Devices.Bluetooth (GATT server). -->
    <TargetFramework>net8.0-windows10.0.19041.0</TargetFramework>
    <SupportedOSPlatformVersion>10.0.17763.0</SupportedOSPlatformVersion>
    <UseWindowsForms>true</UseWindowsForms>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>DeskmateHub</AssemblyName>
    <RootNamespace>DeskmateHub</RootNamespace>
    <Product>Deskmate Hub</Product>
    <Version>0.2.0</Version>
    <ApplicationHighDpiMode>PerMonitorV2</ApplicationHighDpiMode>
    <!-- Lets the project restore/compile on non-Windows machines (CI builds on Windows). -->
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
  </PropertyGroup>

</Project>
