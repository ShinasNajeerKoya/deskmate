app.*.map.json

# Android Studio will place build artifacts here
/android/app/debug
/android/app/profile
/android/app/release

# Deskmate Hub (desktop/) build output
/desktop/mac_driver/.build/
/desktop/mac_driver/.swiftpm/
/desktop/mac_driver/dist/
/desktop/windows_driver/**/bin/
/desktop/windows_driver/**/obj/

# Release signing: never commit keys (they live in ~/.deskmate/)
key.properties
*.jks
*.keystore
